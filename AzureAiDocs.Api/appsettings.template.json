{
  "_readme": "Copy values into User Secrets (recommended) or appsettings.Development.json. Never commit real credentials.",
  "AzureOpenAI": {
    "Endpoint": "https://YOUR-RESOURCE.openai.azure.com/",
    "ApiKey": "YOUR-AZURE-OPENAI-API-KEY",
    "DeploymentName": "gpt-4o-mini",
    "MaxPromptCharacters": 12000
  },
  "AzureStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR-ACCOUNT;AccountKey=YOUR-KEY;EndpointSuffix=core.windows.net",
    "ContainerName": "documents"
  },
  "ApiKeyAuth": {
    "ApiKey": "YOUR-LOCAL-API-KEY"
  },
  "DocumentUpload": {
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".txt", ".pdf" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AzureAiDocs;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
